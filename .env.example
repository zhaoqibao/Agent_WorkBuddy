PYTHONIOENCODING=utf-8
PYTHONUTF8=1


# LANGSMITH相关配置
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=
LANGCHAIN_TRACING_V2=true

# TAVILY相关配置
TAVILY_SEARCH_KEY=

# 本机IP
HOST_IP=127.0.0.1
# 日志文件路径
LOG_FILE=logs/app.log

# MINIO本地相关配置
MINIO_PORT=
MINIO_CONSOLE_PORT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# MySQL 配置
# MySQL 主机地址
MYSQL_HOST=
# MySQL 用户名
MYSQL_USER=
# MySQL 密码
MYSQL_PASSWORD=
# MySQL 数据库名
MYSQL_DATABASE=light_agent


# Milvus 配置-------------阿里云云服务形式
# Milvus URL
MILVUS_URL=
# Milvus Token
MILVUS_TOKEN=
# Milvus 数据库名
MILVUS_DATABASE_NAME=
# Milvus 集合名
MILVUS_COLLECTION_NAME=

# LLM 模型相关配置
OPENAI_API_KEY=
BASE_LLM=Qwen/Qwen3.5-122B-A10B
BASE_VLM=Qwen/Qwen3-VL-30B-A3B-Instruct
IMAGE_MODEL=Qwen/Qwen-Image
EDIT_IMAGE_MODEL=Qwen/Qwen-Image-Edit-2509
MODEL_API_BASE_URL=https://api.siliconflow.cn/v1

# ---- 鉴权（必需）----
JWT_SECRET_KEY=d3e1f2fbf515daec75c9ffb3d51ce3379de5a652ee24330daf4c6a7d889719a1
JWT_ACCESS_EXPIRE=30
JWT_REFRESH_EXPIRE=10080

# ---- 应用 ----
APP_ENV=dev
CORS_ORIGINS=http://localhost:5173

# ---- MySQL 端口（默认 3306）----
MYSQL_PORT=3306

# ---- Redis（强烈建议；未运行则后端需做降级处理）----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- MinIO 端点与桶（端点由 HOST_IP:MINIO_PORT 拼接）----
MINIO_ENDPOINT=
MINIO_BUCKET=

# ---- LLM 开关（已配置密钥，默认开启）----
LLM_ENABLED=true